+    /**
+     * wadjet-harness patch (wadjet#626): builds the arm list a TLP result-set
+     * violation needs and writes the diagnosis dump. Never throws.
+     */
+    private static String dumpTLPViolation(SQLGlobalState<?, ?> state, String oracle, String assertionMessage,
+            String originalQueryString, List<String> resultSet, List<String> combinedString,
+            List<String> secondResultSet) {
+        List<WadjetViolationDump.Arm> arms = new ArrayList<>();
+        // The FULL row set on both sides, not a misses list against one of them:
+        // the dump's stable-vs-transient verdict is only a verdict if the two
+        // quantities it compares are the same quantity.
+        arms.add(WadjetViolationDump.Arm.of("unpartitioned", originalQueryString, resultSet));
+        if (combinedString.size() == 1) {
+            // asUnion: one statement produced the whole partitioned row set.
+            arms.add(WadjetViolationDump.Arm.of("partitioned", combinedString.get(0), secondResultSet));
+        } else {
+            // Three separate partition statements whose rows the oracle only
+            // ever held concatenated. The concatenation carries the verdict;
+            // each branch is still dumped for its own SQL, plan and re-run rows.
+            arms.add(WadjetViolationDump.Arm.of("partitioned (concatenated)",
+                    String.join(" UNION ALL ", combinedString), secondResultSet));
+            for (int i = 0; i < combinedString.size(); i++) {
+                arms.add(WadjetViolationDump.Arm.withoutFirstRead("partition-" + i, combinedString.get(i)));
+            }
+        }
+        return WadjetViolationDump.write(state, oracle, assertionMessage, arms);
+    }
