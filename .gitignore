# Build output. Every binary goes to dist/ (see Taskfile.yml) — one entry
# instead of a per-binary list that has to be maintained.
#
# /wadjet used to be listed here, because `go build -o wadjet` writes INTO
# the wadjet/ package directory rather than refusing. That entry then hid
# every NEW source file in that package from `git status`, and two test
# files were written and lost to it before anyone noticed. Do not add a
# bare /wadjet back.
/dist/
/harness-*.json

# Terraform
*.plan
terraform.tfstate
terraform.tfstate.*.backup
.terraform.lock.hcl
.terraform/

# Stale context / results
/_context/
/results/
.claude-signal

# Claude Code
.claude/

# MinIO data volume
/data/
*.exe
*.dll
*.so
*.dylib

# Test binary
*.test

# Output
*.out
*.prof

# IDE
.idea/
.vscode/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# Vendor (we use modules)
/vendor/

# Local config
*.local.yaml
.env
.env.*
.envrc
.mcp.json

# Codeparty agent workspaces
.codeparty/

# Git worktrees
/.worktrees/

# Terraform state backups
*.tfstate.backup
/clickbench-bench
